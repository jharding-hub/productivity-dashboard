# Apple app-site-association (Face ID/Touch ID sign-in on native). The file
# is deliberately extensionless — Apple's CDN fetches it by exact path — so
# Pages would otherwise serve it as application/octet-stream and Apple's
# validator rejects it. Content-Type must be application/json.
/.well-known/apple-app-site-association
  Content-Type: application/json
